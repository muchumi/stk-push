CONSUMER_KEY=xxxxxxxx              # Your Daraja App Consumer Key
CONSUMER_SECRET=xxxxxxxx           # Your Daraja App Secret
BUSINESS_SHORT_CODE=174379         # Paybill/Till number
PASSKEY=your_passkey               # Provided by Safaricom for your Paybill/Till number
CALLBACK_URL=https://your-domain.com/api/mpesa/callback        # Where Safaricom sends payment results

OAUTH_URL=https://sandbox.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials
STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest        # STK Push API endpoint